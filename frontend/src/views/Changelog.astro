---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { RELEASE_DATE, VERSION } from '../config';
import { localize, t, type Lang } from '../i18n';
import { date } from '../i18n/format';
import { breadcrumbs, webPage } from '../seo/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const c = d.changelog;
const path = '/changelog';
const { changelogTitle: title, changelogDesc: description } = d.meta;
const trail = [{ name: c.breadcrumb, path }];
const site = Astro.site!;
const schema = [webPage(site, lang, path, title, description), breadcrumbs(site, lang, trail)];
---

<Layout lang={lang} path={path} title={title} description={description} schema={schema}>
  <div class="container-page pt-12 sm:pt-16">
    <header class="mx-auto max-w-3xl text-center">
      <Breadcrumbs lang={lang} trail={trail} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight sm:text-5xl">{c.h1}</h1>
      <p class="mt-4 text-lg text-muted">{c.lead}</p>
    </header>

    <section class="mx-auto mt-14 max-w-3xl" aria-labelledby={`v${VERSION}`}>
      <div class="flex flex-wrap items-baseline gap-3 border-b border-line pb-4">
        <h2 id={`v${VERSION}`} class="text-2xl font-semibold">{c.version(VERSION)}</h2>
        <span class="rounded-full bg-accent-soft px-2.5 py-0.5 text-xs font-semibold text-accent">{c.firstRelease}</span>
        <time datetime={RELEASE_DATE} class="ms-auto text-sm text-muted">{date(lang, RELEASE_DATE)}</time>
      </div>
      <div class="guide">
        {
          c.groups.map((grp) => (
            <>
              <h3>{grp.h}</h3>
              <ul>
                {grp.items.map((i) => (
                  <li>{i}</li>
                ))}
              </ul>
            </>
          ))
        }
      </div>
      <p class="mt-12 text-center">
        <a href={localize(lang, '/download')} class="btn-primary">{c.downloadButton(VERSION)}</a>
      </p>
    </section>
  </div>
</Layout>
