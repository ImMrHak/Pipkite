---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { DOWNLOADS, RELEASE_DATE, VERSION } from '../config';
import { localize, t, type Lang } from '../i18n';
import { date } from '../i18n/format';
import { breadcrumbs, webPage } from '../seo/schema';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const dl = d.download;
const L = (p: string) => localize(lang, p);

const { downloadTitle: title, downloadDesc: description } = d.meta;
const trail = [{ name: dl.breadcrumb, path: '/download' }];
const site = Astro.site!;
const schema = [
  webPage(site, lang, '/download', title, description, { about: { '@id': `${site.origin}/#software` } }),
  breadcrumbs(site, lang, trail),
];

const options = [
  { ...DOWNLOADS.installer, kind: 'installer', title: dl.installer.title, badge: dl.installer.badge, text: dl.installer.text },
  { ...DOWNLOADS.portable, kind: 'portable', title: dl.portable.title, badge: null, text: dl.portable.text },
];
---

<Layout lang={lang} path="/download" title={title} description={description} schema={schema}>
  <section class="relative isolate overflow-hidden">
    <div class="bg-grid absolute inset-0 -z-10" aria-hidden="true"></div>
    <div class="container-page pt-14 pb-10 text-center sm:pt-20">
      <Breadcrumbs lang={lang} trail={trail} />
      <h1 class="mt-6 text-4xl font-semibold tracking-tight text-balance sm:text-5xl">{dl.h1}</h1>
      <p class="mx-auto mt-4 max-w-xl text-lg text-muted">
        {dl.sub(VERSION)} <time datetime={RELEASE_DATE}>{date(lang, RELEASE_DATE)}</time>.
        <a href={L('/changelog')} class="text-accent underline-offset-4 hover:underline">{dl.whatsNew}</a>
      </p>
      <p class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-fg" data-downloads={d.hero.downloadsCount} hidden>
        <Icon name="download" size={16} class="text-accent" />
        <span data-downloads-label></span>
      </p>
    </div>
  </section>

  <section class="container-page">
    <div class="mx-auto grid max-w-4xl gap-4 md:grid-cols-2">
      {
        options.map((o) => (
          <article class:list={['card flex flex-col p-6 sm:p-8', o.badge && 'border-accent/60 shadow-[0_0_60px_-20px_var(--glow)]']}>
            <div class="flex items-center justify-between gap-3">
              <h2 class="text-xl font-semibold">{o.title}</h2>
              {o.badge && <span class="rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent">{o.badge}</span>}
            </div>
            <p class="mt-2 text-sm text-muted">{o.text}</p>

            <a href={o.url} download data-dl={o.kind} class:list={['mt-6', o.badge ? 'btn-primary' : 'btn-ghost']}>
              <Icon name="download" size={16} /> {d.common.download} · <span dir="ltr">{o.size}</span>
            </a>
            <p class="mt-3 truncate text-center font-mono text-xs text-muted" title={o.name} dir="ltr">{o.name}</p>

            <div class="mt-6 rounded-xl bg-surface-2 p-3">
              <div class="flex items-center justify-between gap-2">
                <span class="text-xs font-medium text-muted">{dl.sha}</span>
                <button
                  type="button"
                  data-copy={o.sha256}
                  class="inline-flex items-center gap-1 rounded-md px-2 py-1 text-xs text-muted transition hover:bg-surface hover:text-fg"
                >
                  <Icon name="copy" size={13} /> <span data-copy-label>{d.common.copy}</span>
                </button>
              </div>
              <code class="mt-1 block font-mono text-[11px] leading-relaxed break-all text-muted" dir="ltr">{o.sha256}</code>
            </div>
          </article>
        ))
      }
    </div>
    <p class="mx-auto mt-4 max-w-4xl text-center text-xs text-muted">
      {dl.checkHint}
      <code class="rounded bg-surface-2 px-1.5 py-0.5 font-mono" dir="ltr">Get-FileHash .\{DOWNLOADS.installer.name}</code>
    </p>
  </section>

  <section class="container-page mt-20 grid gap-6 lg:grid-cols-[1.4fr_1fr]">
    <div class="card p-6 sm:p-8">
      <h2 class="text-xl font-semibold">{dl.stepsTitle}</h2>
      <ol class="mt-6 space-y-6">
        {
          dl.steps.map((s, i) => (
            <li class="flex gap-4">
              <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-accent-soft text-sm font-semibold text-accent">{i + 1}</span>
              <div>
                <h3 class="font-semibold">{s.title}</h3>
                <p class="mt-1 text-sm text-muted">{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
      <a href={L('/license')} class="btn-ghost mt-8 w-full sm:w-auto">
        <Icon name="key" size={16} />
        {dl.noKey}
      </a>
    </div>

    <div class="card p-6 sm:p-8">
      <h2 class="text-xl font-semibold">{dl.reqTitle}</h2>
      <ul class="mt-6 space-y-3">
        {
          dl.req.map((r) => (
            <li class="flex gap-2.5 text-sm">
              <Icon name="check" size={18} class="mt-px shrink-0 text-good" />
              {r}
            </li>
          ))
        }
      </ul>
      <p class="mt-6 rounded-xl bg-surface-2 p-4 text-xs leading-relaxed text-muted">{dl.reqNote}</p>
    </div>
  </section>
</Layout>
