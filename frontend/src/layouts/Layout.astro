---
import '@fontsource-variable/inter';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
// generated by scripts/subset-arabic.mjs
import notoArabic from '../assets/fonts/noto-sans-arabic-subset.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { API_BASE, DOWNLOADS_PUBLIC_MIN, SITE_NAME } from '../config';
import { THEME_SCRIPT } from '../theme-script.mjs';
import { abs, graph, organization, website } from '../seo/schema';
import { DEFAULT_LANG, LOCALES, LOCALE_META, localize, t, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string; // e.g. '/download', no language prefix
  title: string;
  description: string;
  schema?: Record<string, unknown>[];
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
}

const { lang, path, title, description, schema = [], ogImage = '/og.png', ogType = 'website', noindex = false } = Astro.props;
const d = t(lang);
const meta = LOCALE_META[lang];
const site = Astro.site!;
const canonical = abs(site, localize(lang, path));
const image = abs(site, ogImage);
const alternates = LOCALES.map((l) => ({ lang: l, href: abs(site, localize(l, path)) }));
const jsonLd = JSON.stringify(graph(organization(site), website(site, lang), ...schema)).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={lang} dir={meta.dir} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1'} />
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!noindex && <link rel="alternate" hreflang="x-default" href={abs(site, localize(DEFAULT_LANG, path))} />}

    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    {lang === 'ar' && <link rel="preload" href={notoArabic} as="font" type="font/woff2" crossorigin />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#0b0d11" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={d.meta.ogAlt} />
    <meta property="og:locale" content={meta.og} />
    {LOCALES.filter((l) => l !== lang).map((l) => <meta property="og:locale:alternate" content={LOCALE_META[l].og} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <script type="application/ld+json" set:html={jsonLd} />

    <script is:inline set:html={THEME_SCRIPT} />
  </head>
  <body
    class="min-h-dvh overflow-x-hidden"
    data-copied={d.common.copied}
    data-api={API_BASE}
    data-lang={lang}
    data-page={noindex ? undefined : path}
    data-downloads-min={DOWNLOADS_PUBLIC_MIN}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:start-3 focus:top-3 focus:z-50 focus:rounded-lg focus:bg-accent-solid focus:px-4 focus:py-2 focus:text-white"
      >{d.common.skip}</a
    >
    <Header lang={lang} path={path} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -10% 0px' },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      document.querySelectorAll<HTMLElement>('.spotlight').forEach((el) => {
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          el.style.setProperty('--mx', `${e.clientX - r.left}px`);
          el.style.setProperty('--my', `${e.clientY - r.top}px`);
        });
      });

      // anonymous counters, skipped with GPC / DNT
      const body = document.body.dataset;
      const nav = navigator as Navigator & { globalPrivacyControl?: boolean };
      const optedOut = nav.globalPrivacyControl === true || navigator.doNotTrack === '1';
      const send = (endpoint: string, data: object) => {
        if (optedOut) return;
        fetch(`${body.api}/metrics/${endpoint}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
          keepalive: true, // survives the navigation on download links
          credentials: 'omit',
          referrerPolicy: 'no-referrer',
        }).catch(() => {});
      };
      if (body.page) send('pageview', { path: body.page, lang: body.lang });
      document.addEventListener('click', (ev) => {
        const link = (ev.target as HTMLElement).closest<HTMLElement>('[data-dl]');
        if (link) send('download', { kind: link.dataset.dl });
      });

      const counters = document.querySelectorAll<HTMLElement>('[data-downloads]');
      if (counters.length) {
        fetch(`${body.api}/metrics/downloads`, { credentials: 'omit' })
          .then((r) => (r.ok ? r.json() : null))
          .then((data) => {
            const total = Number(data?.total);
            if (!Number.isFinite(total) || total < Number(body.downloadsMin ?? 500)) return;
            const locale = body.lang === 'ar' ? 'ar-u-nu-latn' : body.lang;
            const n = total.toLocaleString(locale);
            counters.forEach((el) => {
              const label = el.querySelector('[data-downloads-label]');
              if (label) label.textContent = (el.dataset.downloads ?? '{n}').replace('{n}', n);
              el.hidden = false;
            });
          })
          .catch(() => {});
      }

      document.addEventListener('click', async (ev) => {
        const btn = (ev.target as HTMLElement).closest<HTMLElement>('[data-copy], [data-copy-target]');
        if (!btn) return;
        const text =
          btn.dataset.copy ??
          document.querySelector(btn.dataset.copyTarget ?? '')?.textContent?.trim() ??
          '';
        try {
          await navigator.clipboard.writeText(text);
          const label = btn.querySelector('[data-copy-label]');
          if (label) {
            const old = label.textContent;
            label.textContent = document.body.dataset.copied ?? 'Copied';
            setTimeout(() => (label.textContent = old), 1500);
          }
        } catch {
          // clipboard blocked, ignore
        }
      });
    </script>
  </body>
</html>
