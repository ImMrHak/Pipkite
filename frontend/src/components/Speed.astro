---
import Icon from './Icon.astro';
import { BENCH, COMPARISON, COMPARISON_METHOD } from '../config';
import { LOCALE_META, t, type Lang } from '../i18n';
import { num } from '../i18n/format';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const s = d.speed;
const rtl = LOCALE_META[lang].dir === 'rtl';
const msUnit = d.hero.unit;
const usUnit = lang === 'ar' ? 'ميكروثانية' : 'µs';

const values = [
  { n: BENCH.ownOverheadP50Ms, dec: 1, unit: msUnit },
  { n: BENCH.parseP50Us, dec: 1, unit: usUnit },
  { n: BENCH.parseThroughput, dec: 0, unit: '' },
  { n: BENCH.flushesPerOrder, dec: 0, unit: '' },
];

// comparison rows only show up once COMPARISON in config.ts has real numbers
const hasComparison = COMPARISON.length > 0;
const rows = hasComparison
  ? [{ label: 'SignalRelay', p50Ms: BENCH.ownOverheadP50Ms, us: true }, ...COMPARISON.map((c) => ({ ...c, us: false }))]
  : [
      { label: s.rowUs, p50Ms: BENCH.ownOverheadP50Ms, us: true },
      { label: s.rowBefore, p50Ms: BENCH.ownOverheadBeforeP50Ms, us: false },
    ];
rows.sort((a, b) => a.p50Ms - b.p50Ms);
const max = Math.max(...rows.map((r) => r.p50Ms));
const fastest = rows[0]?.us === true;
// svg width attribute instead of style= (CSP)
const pct = (v: number) => Math.max(4, (v / max) * 100);
---

<section id="speed" class="relative isolate scroll-mt-20 overflow-hidden py-24">
  <div class="glow absolute top-1/3 -end-40 -z-10 size-[600px]" aria-hidden="true"></div>
  <div class="container-page grid items-center gap-14 lg:grid-cols-2">
    <div class="reveal">
      <p class="eyebrow">{s.eyebrow}</p>
      <h2 class="section-title mt-3">{s.title}</h2>
      <p class="section-lead" set:html={s.leadHtml} />
      <p class="mt-4 text-sm text-muted">{s.proof}</p>

      <dl class="mt-10 grid grid-cols-2 gap-4">
        {
          values.map((v, i) => (
            <div class="spotlight card p-5">
              <dt class="text-sm text-muted">{s.stats[i].label}</dt>
              <dd class="mt-1 text-2xl font-semibold tracking-tight tabular-nums sm:text-3xl">
                <span data-count={v.n} data-dec={v.dec}>{num(lang, v.n, v.dec)}</span>
                {v.unit && <span class="text-xl sm:text-2xl"> {v.unit}</span>}
              </dd>
              <dd class="mt-1 text-xs text-muted">{s.stats[i].note}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <div class="reveal card p-6 sm:p-8">
      <div class="flex items-start justify-between gap-4">
        <div>
          <h3 class="font-semibold">{s.chartTitle}</h3>
          <p class="mt-1 text-sm text-muted">{s.chartSub}</p>
        </div>
        {
          fastest && hasComparison && (
            <span class="inline-flex shrink-0 items-center gap-1 rounded-full bg-accent-soft px-3 py-1 text-xs font-semibold text-accent">
              <Icon name="zap" size={14} /> {s.fastest}
            </span>
          )
        }
      </div>

      <ul class="mt-8 space-y-5">
        {
          rows.map((r) => (
            <li>
              <div class="flex items-baseline justify-between text-sm">
                <span class:list={[r.us ? 'font-semibold' : 'text-muted']}>{r.label}</span>
                <span class="tabular-nums">
                  <span class="font-mono">{num(lang, r.p50Ms, 1)}</span> {msUnit}
                </span>
              </div>
              <svg class="mt-2 block h-3 w-full overflow-hidden rounded-full" aria-hidden="true">
                <rect width="100%" height="100%" fill="var(--surface-2)" />
                <rect
                  class="bar"
                  x={rtl ? `${100 - pct(r.p50Ms)}%` : '0'}
                  width={`${pct(r.p50Ms)}%`}
                  height="100%"
                  rx="6"
                  fill={r.us ? 'var(--accent)' : 'var(--muted)'}
                  opacity={r.us ? 1 : 0.4}
                />
              </svg>
            </li>
          ))
        }
      </ul>

      {
        !hasComparison && (
          <p class="mt-8 rounded-xl bg-surface-2 p-4 text-sm text-muted">
            <strong class="font-semibold text-fg">{s.improvementStrong}</strong> {s.improvement}
          </p>
        )
      }

      <p class="mt-6 text-xs leading-relaxed text-muted">
        {hasComparison && COMPARISON_METHOD ? `${COMPARISON_METHOD} ` : ''}
        {s.reference}
      </p>
    </div>
  </div>
</section>

<script>
  const els = document.querySelectorAll<HTMLElement>('#speed [data-count]');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const lang = document.documentElement.lang;
  const locale = lang === 'ar' ? 'ar-u-nu-latn' : lang;
  const io = new IntersectionObserver(
    ([e]) => {
      if (!e.isIntersecting || reduce) return;
      io.disconnect();
      els.forEach((el) => {
        const target = Number(el.dataset.count);
        const dec = Number(el.dataset.dec);
        const fmt = (v: number) => v.toLocaleString(locale, { minimumFractionDigits: dec, maximumFractionDigits: dec });
        const start = performance.now();
        const tick = (now: number) => {
          const p = Math.min(1, (now - start) / 1200);
          el.textContent = fmt(target * (1 - Math.pow(1 - p, 3)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
    },
    { threshold: 0.4 },
  );
  io.observe(document.getElementById('speed')!);
</script>
