---
import Icon from './Icon.astro';
import { BENCH } from '../config';
import { t, type Lang } from '../i18n';
import { num } from '../i18n/format';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const d = t(lang);
const f = d.how.fields;
const parsed = [
  { k: f.symbol, v: 'XAUUSD' },
  { k: f.side, v: 'BUY', cls: 'text-good' },
  { k: f.entry, v: '4295 – 4299', note: f.entryNote },
  { k: f.sl, v: '4282' },
  { k: f.tps, v: '4307 · 4317 · 4330' },
];
---

<section id="how" class="scroll-mt-20 py-24">
  <div class="container-page">
    <div class="reveal mx-auto max-w-2xl text-center">
      <p class="eyebrow">{d.how.eyebrow}</p>
      <h2 class="section-title mt-3">{d.how.title}</h2>
      <p class="section-lead">{d.how.lead}</p>
    </div>

    <!-- step delays: data-d in global.css -->
    <div id="demo" class="demo reveal mx-auto mt-14 grid max-w-6xl items-stretch gap-4 lg:grid-cols-[1fr_auto_1.1fr_auto_1fr]">
      <div class="card p-5">
        <p class="flex items-center gap-2 text-xs font-medium tracking-wide text-muted uppercase">
          <span class="grid size-5 place-items-center rounded-full bg-[#2aabee] text-white"><Icon name="send" size={11} /></span>
          {d.how.step1}
        </p>
        <div class="step mt-4 rounded-2xl rounded-ss-sm bg-surface-2 p-4" data-d="0" dir="ltr">
          <p class="text-xs font-semibold text-[#2aabee]">Gold Signals VIP</p>
          <p class="mt-1.5 text-sm leading-relaxed">
            {['🟡 GOLD BUY NOW 4299 - 4295', 'SL 4282', 'TP1 4307 🎯', 'TP2 4317', 'TP3 4330'].map((l) => <span class="block">{l}</span>)}
          </p>
          <p class="mt-1 text-right text-[11px] text-muted">09:41</p>
        </div>
      </div>

      <div class="hidden items-center lg:flex" aria-hidden="true"><div class="flow-line h-0.5 w-10 rounded-full"></div></div>

      <div class="card p-5">
        <p class="flex items-center gap-2 text-xs font-medium tracking-wide text-muted uppercase">
          <span class="grid size-5 place-items-center rounded-full bg-accent-solid text-white"><Icon name="cpu" size={11} /></span>
          {d.how.step2}
        </p>
        <dl class="mt-4 divide-y divide-line text-sm">
          {
            parsed.map((p, i) => (
              <div class="step flex items-baseline justify-between gap-4 py-2" data-d={String(i + 1)}>
                <dt class="text-muted">{p.k}</dt>
                <dd class:list={['text-end font-mono font-medium', p.cls]}>
                  <span dir="ltr">{p.v}</span>
                  {p.note && <span class="block font-sans text-xs font-normal text-muted">{p.note}</span>}
                </dd>
              </div>
            ))
          }
        </dl>
        <div class="mt-3 flex flex-wrap gap-2">
          <span class="step inline-flex items-center gap-1 rounded-full bg-good/15 px-2.5 py-1 text-xs font-semibold text-good" data-d="6">
            <Icon name="sparkles" size={13} />
            {d.how.aiGood}
          </span>
          <span class="step inline-flex items-center gap-1 rounded-full bg-accent-soft px-2.5 py-1 text-xs font-semibold text-accent" data-d="7">
            <Icon name="shield" size={13} />
            {d.how.checksOk}
          </span>
        </div>
      </div>

      <div class="hidden items-center lg:flex" aria-hidden="true"><div class="flow-line h-0.5 w-10 rounded-full"></div></div>

      <div class="card flex flex-col p-5">
        <p class="flex items-center gap-2 text-xs font-medium tracking-wide text-muted uppercase">
          <span class="grid size-5 place-items-center rounded-full bg-fg text-bg"><Icon name="terminal" size={11} /></span>
          {d.how.step3}
        </p>
        <div class="step mt-4 flex-1 rounded-xl border border-line bg-bg p-4 font-mono text-sm" data-d="8" dir="ltr">
          <div class="flex items-center justify-between">
            <span class="font-semibold">XAUUSD</span>
            <span class="rounded bg-good/15 px-1.5 py-0.5 text-xs font-semibold text-good">BUY LIMIT</span>
          </div>
          <p class="mt-3 flex justify-between text-muted">Volume <span class="text-fg">0.01</span></p>
          <p class="flex justify-between text-muted">S/L <span class="text-fg">4282.00</span></p>
          <p class="flex justify-between text-muted">T/P <span class="text-fg">4307.00</span></p>
        </div>
        <div class="step mt-3 flex items-center justify-between rounded-xl bg-accent-solid px-4 py-2.5 text-white" data-d="9">
          <span class="inline-flex items-center gap-1.5 text-sm font-semibold"><Icon name="zap" size={15} /> {d.how.sent}</span>
          <span class="text-sm"><span class="font-mono">{num(lang, BENCH.ownOverheadP50Ms, 1)}</span> {d.hero.unit}</span>
        </div>
      </div>
    </div>
    <p class="reveal mt-4 text-center text-xs text-muted">{d.how.illustration}</p>

    <div class="reveal mx-auto mt-24 max-w-2xl text-center">
      <h3 class="text-2xl font-semibold tracking-tight">{d.how.setupTitle}</h3>
    </div>
    <div class="relative mt-10">
      <div class="absolute inset-x-[12%] top-[38px] hidden h-px bg-gradient-to-r from-transparent via-line to-transparent lg:block" aria-hidden="true"></div>
      <ol class="relative grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          d.how.steps.map((s, i) => (
            <li class="reveal spotlight card relative p-6" data-stagger={String(i)}>
              <span class="grid size-9 place-items-center rounded-xl bg-accent-solid text-sm font-semibold text-white shadow-[0_6px_20px_-6px_var(--glow)]">
                {i + 1}
              </span>
              <h4 class="mt-4 font-semibold">{s.title}</h4>
              <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<script>
  const demo = document.getElementById('demo')!;
  let timer: number | undefined;
  const play = () => {
    demo.classList.remove('play');
    void demo.offsetWidth; // forces a reflow so the animation restarts
    demo.classList.add('play');
  };
  new IntersectionObserver(
    ([e]) => {
      clearInterval(timer);
      if (e.isIntersecting) {
        play();
        timer = window.setInterval(play, 7000);
      }
    },
    { threshold: 0.35 },
  ).observe(demo);
</script>
