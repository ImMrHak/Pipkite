// Win32 resources: application icon and version info.
#include <winres.h>

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "SignalRelay"
      VALUE "FileDescription", "SignalRelay - Telegram to MetaTrader 5 signal copier"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "SignalRelay"
      VALUE "ProductVersion", "1.0.0"
      VALUE "OriginalFilename", "SignalRelay.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
